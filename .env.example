# Copia este fichero a .env y rellena los valores. .env NUNCA se sube a git.
DATABASE_URL=postgresql://localhost/amr_agent
DATABASE_URL_TEST=postgresql://localhost/amr_agent_test

# LLM (cualquier API compatible con OpenAI). Key gratis en https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Opcional: https://account.ncbi.nlm.nih.gov/settings/ -> API Key Management
NCBI_API_KEY=
NCBI_EMAIL=
